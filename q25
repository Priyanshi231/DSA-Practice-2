class Solution {
public:
    long long MOD = 1e9 + 7;
    long long findpow(long long a, long long b){
        if(b == 0) return 1;

        long long half = findpow(a,b/2);
        long long res = (half*half);
        if(b%2 != 0){
            res = res*a;
        }
        return res% MOD;
    }
    int countGoodNumbers(long long n) {
        long long even = (n+1)/2;
        long long odd = n/2;

        long long p1 = findpow(5,even);
        long long p2 = findpow(4,odd);

        return (p1*p2)%MOD;      
    }
};
