class Solution{
public:
    int longestSubarray(vector<int> &nums, int k){
        int l=0;
        int sum = 0;
        int ans = 0;
        for(int r = 0; r<nums.size(); r++){
            sum += nums[r];
            while(sum > k){
                sum -= nums[l];
                l++;
            }
            if(sum == k ){
                ans = max(ans,r-l+1);
            }
        }
        return ans;
    }
};
