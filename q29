class Solution {
public:
    int majorityElement(vector<int>& nums) {
        int n = nums.size();
        int curr = nums[0];
        int c = 0;
        for(int i=0; i<n; i++){
            if(c == 0){
                curr = nums[i];
            }

            if(nums[i] == curr){
                c++;
            }else{
                c--;
            }
        }
        return curr;
    }
};
