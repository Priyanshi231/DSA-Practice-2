class Solution {
public:
    int helper(string s, int i, long long num, int sign){
        if(i >= s.size() || !isdigit(s[i])){
            return num * sign;
        }
        int digit = s[i] - '0';

        if(num > (INT_MAX - digit)/10){
            if(sign == 1) return INT_MAX;
            return INT_MIN;
        }

        num = num* 10 + digit;

        return helper(s,i+1,num,sign);
    }
    int myAtoi(string s) {
        int i = 0;
        int n = s.size();
        int sign = 1;

        while(i<n && s[i] == ' '){
            i++;
        }

        if(i<n && (s[i] == '-' || s[i] == '+') ) {
            if(s[i] == '-') sign = -1;
            i++;
        }
        return helper(s,i,0,sign);
    }
};
