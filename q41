class Solution {
public:
    vector<int> leaders(vector<int>& nums) {
        int n = nums.size();
        vector<int> ans;

        int maxi = nums[n-1];
        ans.push_back(maxi);
        
        for(int i=n-2; i>=0; i--){         
            if(nums[i] >= maxi){
                maxi = nums[i];
                ans.push_back(maxi);
            }
        }
        reverse(ans.begin(),ans.end());
        return ans;
    }
};
