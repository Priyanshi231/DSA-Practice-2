class Solution{
    public:  
    int solve(int i, vector<int>& nums, int sum ,int k){
        if(i == nums.size()){
            if(sum == k){
                return 1;
            }
            return 0;
        }
        int take = solve(i+1, nums, sum + nums[i],k);

        int nottake = solve(i+1, nums, sum , k);

        return take + nottake;
    }  	
    int countSubsequenceWithTargetSum(vector<int>& nums, int k){
    	//your code goes here
        return solve(0,nums,0,k);
    }
};
