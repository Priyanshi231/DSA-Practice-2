class Solution{
public:
    int longestSubarray(vector<int> &nums, int k){
        unordered_map<long long, int> m;
        long long sum = 0;
        int ans = 0;
        for(int i=0; i<nums.size(); i++){
            sum += nums[i];
            long long res = sum - k; 
            if(m.find(res) != m.end()){
                ans = max(ans, i-m[res]);
            }
            if(m.find(sum) == m.end()){
                m[sum]=i;
            }
        }
        return ans;
    }
};
